# collector/ 에서 `cp ../.env.example .env` 후 채운다.
# GitHub 에서는 이 값들을 Settings > Secrets and variables > Actions 에 등록한다.
# 브라우저 코드에는 절대 넣지 않는다 (정적 사이트라 그대로 노출된다).

# 고용24(워크넷) 채용정보 API — 공공데이터포털에서 활용신청 후 발급
# 문서에서 정확한 엔드포인트/파라미터명을 확인한 뒤 채울 것
WORKNET_ENDPOINT=
WORKNET_SERVICE_KEY=

# 사람인 오픈 API — 개발자센터에서 발급, 이용약관 확인 필수
SARAMIN_ENDPOINT=
SARAMIN_ACCESS_KEY=

# 미검증 소스도 강제로 실행하고 싶을 때만 1
SKIP_VERIFY=
